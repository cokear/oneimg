{
  "name": "axenthost_all_in_one",
  "label": "AxentHost 自动助手（登录+领取+抽奖）",
  "url": "https://app.axenthost.com/credits",
  "enabled": true,
  "timeout": 480000,
  "timerMode": "window",
  "cooldownMinutes": "60-70",
  "windowSeconds": 180,
  "defaultData": {},
  "script": [
    "async function(ctx) {",
    "  const LOGIN_EMAIL = 'YOUR_EMAIL_HERE';",
    "  const LOGIN_PASSWORD = 'YOUR_PASSWORD_HERE';",
    "  const CLAIM_LIMIT = 5;",
    "  const CLAIM_FALLBACK_MS = 60 * 60 * 1000;",
    "  const SPIN_FALLBACK_MS = 24 * 60 * 60 * 1000;",
    "  const CLAIM_REFRESH_MAX = 3;",
    "  const LOGIN_REFRESH_MAX = 2;",
    "  const notifyId = (ctx.variables && ctx.variables.tg_notify_chat_id) || '5878981847';",
    "  const wait = (ms) => ctx.wait(ms);",
    "  const log = async (message) => {",
    "    if (ctx.log) await ctx.log(`[AxentHost] ${message}`);",
    "  };",
    "",
    "  const getNumber = (key, fallback) => {",
    "    const value = Number(window.localStorage.getItem(key));",
    "    return Number.isFinite(value) ? value : fallback;",
    "  };",
    "  const setNumber = (key, value) => {",
    "    const number = Number(value);",
    "    if (Number.isFinite(number)) window.localStorage.setItem(key, String(Math.max(0, Math.floor(number))));",
    "  };",
    "  const setText = (key, value) => window.localStorage.setItem(key, String(value || ''));",
    "  const getState = () => ({",
    "    nextClaimTime: getNumber('ax_next_claim', 0),",
    "    nextSpinTime: getNumber('ax_next_spin', 0),",
    "    claimsLeft: getNumber('ax_claims_left', CLAIM_LIMIT),",
    "    totalCredits: window.localStorage.getItem('ax_total_credits') || ''",
    "  });",
    "  const setClaimsLeft = (value) => {",
    "    const number = Number(value);",
    "    if (Number.isFinite(number)) setNumber('ax_claims_left', Math.max(0, Math.min(CLAIM_LIMIT, number)));",
    "  };",
    "  const formatDelay = (ms) => {",
    "    if (!Number.isFinite(ms) || ms <= 0) return '已到时间';",
    "    const minutes = Math.ceil(ms / 60000);",
    "    if (minutes < 60) return `${minutes} 分钟`;",
    "    const hours = Math.floor(minutes / 60);",
    "    const rest = minutes % 60;",
    "    return rest ? `${hours} 小时 ${rest} 分钟` : `${hours} 小时`;",
    "  };",
    "  const exportState = (extra) => {",
    "    const state = getState();",
    "    const now = Date.now();",
    "    const publicExtra = {};",
    "    for (const [key, value] of Object.entries(extra || {})) {",
    "      if (key === 'phase' || key.startsWith('ax_')) continue;",
    "      publicExtra[key] = value;",
    "    }",
    "    return {",
    "      tg_notify_chat_id: notifyId,",
    "      __webtask_next_run_at: computeNextRunAt(),",
    "      剩余金币: state.totalCredits || '--',",
    "      金币领取剩余: `${state.claimsLeft}/${CLAIM_LIMIT}`,",
    "      金币冷却: state.nextClaimTime > now ? formatDelay(state.nextClaimTime - now) : '已到时间',",
    "      转盘冷却: state.nextSpinTime > now ? formatDelay(state.nextSpinTime - now) : '已到时间',",
    "      ...publicExtra",
    "    };",
    "  };",
    "  const done = (success, message, extra, keepOpen) => ({",
    "    success,",
    "    message,",
    "    keepOpen: !!keepOpen,",
    "    variables: exportState(extra || {}),",
    "    nextRunAt: success ? computeNextRunAt() : undefined",
    "  });",
    "",
    "  const parseTimeTextToMs = (text) => {",
    "    const raw = String(text || '').trim();",
    "    if (!raw) return 0;",
    "    const parts = raw.split(':').map((part) => Number(part));",
    "    if (parts.some((part) => !Number.isFinite(part))) return 0;",
    "    if (parts.length === 3) return (parts[0] * 3600 + parts[1] * 60 + parts[2]) * 1000;",
    "    if (parts.length === 2) return (parts[0] * 60 + parts[1]) * 1000;",
    "    return 0;",
    "  };",
    "  const killPopups = () => {",
    "    document.querySelectorAll('[id*=\"interstitial\"], ins[id^=\"gpt_unit_\"]').forEach((ad) => ad.remove());",
    "    document.querySelectorAll('[aria-label=\"Close ad\"], [aria-label=\"Close\"], #dismiss-button, .close-button').forEach((button) => {",
    "      if (button.offsetWidth > 0 || button.offsetHeight > 0) button.click();",
    "    });",
    "    document.querySelectorAll('iframe[id^=\"aswift\"], iframe[name^=\"aswift\"]').forEach((iframe) => {",
    "      let parent = iframe.parentElement;",
    "      while (parent && parent.tagName !== 'BODY') {",
    "        const style = window.getComputedStyle(parent);",
    "        const zIndex = Number.parseInt(style.zIndex, 10);",
    "        if (zIndex > 10000 && (style.position === 'fixed' || style.position === 'absolute')) {",
    "          parent.remove();",
    "          break;",
    "        }",
    "        parent = parent.parentElement;",
    "      }",
    "    });",
    "  };",
    "",
    "  const readClaimsLeft = () => {",
    "    const counter = document.querySelector('.font-s1.mx-auto.mt-2');",
    "    const text = counter ? (counter.innerText || counter.textContent || '') : '';",
    "    const match = text.match(/(\\d+)\\s*\\/\\s*5/);",
    "    return match ? Number(match[1]) : null;",
    "  };",
    "  const readCredits = () => {",
    "    const credit = document.querySelector('.credit-balance');",
    "    const text = credit ? (credit.textContent || '') : '';",
    "    return text ? text.replace(/\\D/g, '') : '';",
    "  };",
    "  const syncPageState = () => {",
    "    const claimsLeft = readClaimsLeft();",
    "    if (claimsLeft !== null) setClaimsLeft(claimsLeft);",
    "    const credits = readCredits();",
    "    if (credits) setText('ax_total_credits', credits);",
    "  };",
    "  const refreshClaimQuotaIfReady = () => {",
    "    const state = getState();",
    "    const now = Date.now();",
    "    if (state.nextClaimTime > 0 && now >= state.nextClaimTime) {",
    "      setNumber('ax_next_claim', 0);",
    "      setClaimsLeft(CLAIM_LIMIT);",
    "      return true;",
    "    }",
    "    if (state.nextClaimTime <= 0 && state.claimsLeft <= 0) {",
    "      setClaimsLeft(CLAIM_LIMIT);",
    "      return true;",
    "    }",
    "    return false;",
    "  };",
    "  const choosePhase = () => {",
    "    refreshClaimQuotaIfReady();",
    "    const state = getState();",
    "    const now = Date.now();",
    "    if (state.claimsLeft > 0 && now >= state.nextClaimTime) return 'claim';",
    "    if (now >= state.nextSpinTime) return 'spin';",
    "    return '';",
    "  };",
    "  const computeNextRunAt = () => {",
    "    refreshClaimQuotaIfReady();",
    "    const state = getState();",
    "    const now = Date.now();",
    "    const candidates = [];",
    "    if (state.nextClaimTime > now) candidates.push(state.nextClaimTime);",
    "    if (state.claimsLeft > 0 && state.nextClaimTime <= now) candidates.push(now + 1000);",
    "    if (state.nextSpinTime > now) candidates.push(state.nextSpinTime);",
    "    if (candidates.length === 0) return now + 60 * 1000;",
    "    return Math.min(...candidates);",
    "  };",
    "  const idleMessage = () => {",
    "    const state = getState();",
    "    const now = Date.now();",
    "    const claimWait = state.nextClaimTime > now ? formatDelay(state.nextClaimTime - now) : '已到时间';",
    "    const spinWait = state.nextSpinTime > now ? formatDelay(state.nextSpinTime - now) : '已到时间';",
    "    return `剩余金币 ${state.totalCredits || '--'}；等待下次：金币 ${claimWait}，转盘 ${spinWait}`;",
    "  };",
    "",
    "  const isLoginPage = () => {",
    "    if (window.location.pathname === '/login') return true;",
    "    return !!document.querySelector('input[type=\"email\"]') && !!document.querySelector('input[type=\"password\"]');",
    "  };",
    "  const gotoPhase = async (path, phase, extra) => {",
    "    ctx.variables.phase = phase;",
    "    Object.assign(ctx.variables, exportState(extra || {}));",
    "    await log(`跳转到 ${path}，阶段 ${phase || 'dashboard'}`);",
    "    if (window.location.pathname === path) {",
    "      await ctx.reload();",
    "    } else {",
    "      await ctx.navigate(path);",
    "    }",
    "  };",
    "  const reloadPhase = async (phase, reason, extra) => {",
    "    ctx.variables.phase = phase;",
    "    Object.assign(ctx.variables, exportState(extra || {}));",
    "    await log(`${reason}，刷新重试`);",
    "    await ctx.reload();",
    "  };",
    "  const continueOrFinish = async (message, extra) => {",
    "    syncPageState();",
    "    const nextPhase = choosePhase();",
    "    if (nextPhase === 'claim') {",
    "      await log('金币次数还没用完，继续领取');",
    "      await gotoPhase('/claim', 'claim', extra);",
    "      return undefined;",
    "    }",
    "    if (nextPhase === 'spin') {",
    "      await log('转盘到时间，准备抽奖');",
    "      await gotoPhase('/spin', 'spin', extra);",
    "      return undefined;",
    "    }",
    "    return done(true, `${message}；${idleMessage()}`, extra, false);",
    "  };",
    "",
    "  const findSpinButton = () => {",
    "    const candidates = Array.from(document.querySelectorAll('div.spin, button.spin, .spin, button, [role=\"button\"]'));",
    "    return candidates.find((item) => {",
    "      const text = (item.innerText || item.textContent || '').trim().toUpperCase();",
    "      return text.includes('SPIN') && !item.classList.contains('disabled');",
    "    });",
    "  };",
    "  const getSpinCooldownText = () => {",
    "    for (const item of document.querySelectorAll('span.text-white.font-s4')) {",
    "      const text = (item.innerText || item.textContent || '').trim();",
    "      if (/^\\d{1,2}:\\d{2}(:\\d{2})?$/.test(text) && !item.closest('.spin')) return text;",
    "    }",
    "    return '';",
    "  };",
    "",
    "  const handleLogin = async (nextPhase) => {",
    "    if (!LOGIN_EMAIL || !LOGIN_PASSWORD || LOGIN_EMAIL === 'YOUR_EMAIL_HERE' || LOGIN_PASSWORD === 'YOUR_PASSWORD_HERE') {",
    "      return done(false, '检测到登录页，但脚本里的 LOGIN_EMAIL/LOGIN_PASSWORD 还没有填写', { phase: 'login' }, true);",
    "    }",
    "    await log('检测到登录页，尝试自动登录');",
    "    const loginRefreshCount = Number(ctx.variables.ax_login_refresh_count || 0);",
    "    const loginDeadline = Date.now() + 180000;",
    "    while (Date.now() < loginDeadline) {",
    "      killPopups();",
    "      const emailInput = document.querySelector('input[type=\"email\"]');",
    "      const passwordInput = document.querySelector('input[type=\"password\"]');",
    "      const cfToken = document.querySelector('[name=\"cf-turnstile-response\"]');",
    "      const loginBtn = document.querySelector('button.btn-gradient-primary:not(.disabled)');",
    "      if (emailInput && emailInput.value !== LOGIN_EMAIL) {",
    "        emailInput.value = LOGIN_EMAIL;",
    "        emailInput.dispatchEvent(new Event('input', { bubbles: true }));",
    "        emailInput.dispatchEvent(new Event('change', { bubbles: true }));",
    "      }",
    "      if (passwordInput && passwordInput.value !== LOGIN_PASSWORD) {",
    "        passwordInput.value = LOGIN_PASSWORD;",
    "        passwordInput.dispatchEvent(new Event('input', { bubbles: true }));",
    "        passwordInput.dispatchEvent(new Event('change', { bubbles: true }));",
    "      }",
    "      if (loginBtn && cfToken && (cfToken.value || '').length > 100) {",
    "        await log('CF Token 就绪，提交登录');",
    "        loginBtn.click();",
    "        ctx.variables.phase = nextPhase || '';",
    "        await wait(3000);",
    "        if (!isLoginPage()) {",
    "          await gotoPhase('/credits', '', { phase: '' });",
    "          return undefined;",
    "        }",
    "      }",
    "      await wait(1000);",
    "    }",
    "    if (loginRefreshCount < LOGIN_REFRESH_MAX) {",
    "      await reloadPhase('login', '登录页 CF 长时间未就绪', { ax_login_refresh_count: loginRefreshCount + 1 });",
    "      return undefined;",
    "    }",
    "    return done(false, '登录阶段超时，可能需要人工完成 CF 或检查账号密码', { phase: 'login' }, true);",
    "  };",
    "",
    "  const handleClaim = async () => {",
    "    if (window.location.pathname !== '/claim') {",
    "      await gotoPhase('/claim', 'claim');",
    "      return undefined;",
    "    }",
    "    await log('开始领取金币阶段');",
    "    const claimRefreshCount = Number(ctx.variables.ax_claim_refresh_count || 0);",
    "    const deadline = Date.now() + 180000;",
    "    let clicked = false;",
    "    let waitingForCfSince = 0;",
    "    let clickedAt = 0;",
    "    let claimsBeforeClick = null;",
    "    while (Date.now() < deadline) {",
    "      killPopups();",
    "      if (isLoginPage()) {",
    "        await gotoPhase('/login', 'login', { phase: 'claim' });",
    "        return undefined;",
    "      }",
    "      syncPageState();",
    "      const disabledTimer = document.querySelector('button.disabled span.font-s4');",
    "      if (disabledTimer) {",
    "        const cooldownMs = parseTimeTextToMs(disabledTimer.textContent || '');",
    "        if (cooldownMs > 0) {",
    "          setNumber('ax_next_claim', Date.now() + cooldownMs);",
    "          setClaimsLeft(0);",
    "          await log(`金币进入冷却，约 ${formatDelay(cooldownMs)}`);",
    "          return continueOrFinish('金币领取已进入冷却', { ax_claim_cooldown_ms: cooldownMs, phase: '' });",
    "        }",
    "      }",
    "      const bodyText = document.body && document.body.innerText ? document.body.innerText : '';",
    "      if (clicked && bodyText.includes('Credits successfully claimed')) {",
    "        const pageClaimsLeft = readClaimsLeft();",
    "        const baseClaimsLeft = claimsBeforeClick === null ? getState().claimsLeft : claimsBeforeClick;",
    "        const nextClaimsLeft = pageClaimsLeft !== null && pageClaimsLeft < baseClaimsLeft ? pageClaimsLeft : Math.max(0, baseClaimsLeft - 1);",
    "        setClaimsLeft(nextClaimsLeft);",
    "        if (nextClaimsLeft <= 0 && getState().nextClaimTime <= Date.now()) {",
    "          setNumber('ax_next_claim', Date.now() + CLAIM_FALLBACK_MS);",
    "        }",
    "        syncPageState();",
    "        await log(`领取成功，剩余 ${getState().claimsLeft}/${CLAIM_LIMIT}`);",
    "        return continueOrFinish('金币领取完成', { ax_claims_left: getState().claimsLeft, ax_total_credits: getState().totalCredits, phase: '' });",
    "      }",
    "      const claimBtn = document.querySelector('button.btn-gradient-primary:not(.disabled)');",
    "      const cfToken = document.querySelector('[name=\"cf-turnstile-response\"]');",
    "      if (claimBtn && !clicked) {",
    "        if (cfToken && (cfToken.value || '').trim().length <= 100) {",
    "          waitingForCfSince = waitingForCfSince || Date.now();",
    "          if (Date.now() - waitingForCfSince > 90000) {",
    "            if (claimRefreshCount < CLAIM_REFRESH_MAX) {",
    "              await reloadPhase('claim', '领取 CF 验证长时间未就绪', { ax_claim_refresh_count: claimRefreshCount + 1, ax_claims_left: getState().claimsLeft });",
    "              return undefined;",
    "            }",
    "            return done(false, '等待领取 CF 验证超时，请人工通过后重试', { ax_claims_left: getState().claimsLeft }, true);",
    "          }",
    "          await log('等待领取 CF 验证 token');",
    "        } else {",
    "          claimsBeforeClick = readClaimsLeft();",
    "          if (claimsBeforeClick !== null) setClaimsLeft(claimsBeforeClick);",
    "          claimBtn.click();",
    "          clicked = true;",
    "          clickedAt = Date.now();",
    "          await log('已点击领取按钮');",
    "        }",
    "      }",
    "      if (clicked && clickedAt && Date.now() - clickedAt > 60000) {",
    "        if (claimRefreshCount < CLAIM_REFRESH_MAX) {",
    "          await reloadPhase('claim', '点击领取后未检测到结果', { ax_claim_refresh_count: claimRefreshCount + 1, ax_claims_left: getState().claimsLeft });",
    "          return undefined;",
    "        }",
    "      }",
    "      await wait(1000);",
    "    }",
    "    if (claimRefreshCount < CLAIM_REFRESH_MAX) {",
    "      await reloadPhase('claim', '领取阶段超时未检测到结果', { ax_claim_refresh_count: claimRefreshCount + 1, ax_claims_left: getState().claimsLeft });",
    "      return undefined;",
    "    }",
    "    return done(false, '领取阶段超时，未检测到成功提示或冷却计时', { ax_claims_left: getState().claimsLeft, phase: 'claim' }, true);",
    "  };",
    "",
    "  const handleSpin = async () => {",
    "    if (window.location.pathname !== '/spin') {",
    "      await gotoPhase('/spin', 'spin');",
    "      return undefined;",
    "    }",
    "    await log('开始转盘阶段');",
    "    const deadline = Date.now() + 120000;",
    "    let clicked = false;",
    "    while (Date.now() < deadline) {",
    "      killPopups();",
    "      if (isLoginPage()) {",
    "        await gotoPhase('/login', 'login', { phase: 'spin' });",
    "        return undefined;",
    "      }",
    "      syncPageState();",
    "      const timerText = getSpinCooldownText();",
    "      if (timerText) {",
    "        const cooldownMs = parseTimeTextToMs(timerText);",
    "        if (cooldownMs > 0) {",
    "          setNumber('ax_next_spin', Date.now() + cooldownMs);",
    "          await log(`转盘冷却中，约 ${formatDelay(cooldownMs)}`);",
    "          return continueOrFinish('转盘已进入冷却', { ax_spin_cooldown_ms: cooldownMs, phase: '' });",
    "        }",
    "      }",
    "      const spinBtn = findSpinButton();",
    "      if (spinBtn && !clicked) {",
    "        spinBtn.click();",
    "        clicked = true;",
    "        await log('已点击 Spin 按钮');",
    "      }",
    "      await wait(1000);",
    "    }",
    "    if (clicked) {",
    "      setNumber('ax_next_spin', Date.now() + SPIN_FALLBACK_MS);",
    "      return continueOrFinish('转盘已点击，未读到页面冷却，按 24 小时计时', { ax_spin_cooldown_ms: SPIN_FALLBACK_MS, phase: '' });",
    "    }",
    "    return done(false, '转盘阶段超时，未检测到 Spin 按钮或冷却计时', { phase: 'spin' }, true);",
    "  };",
    "",
    "  killPopups();",
    "  await wait(1800);",
    "  killPopups();",
    "  syncPageState();",
    "  let phase = (ctx.variables && ctx.variables.phase) || choosePhase();",
    "  if (isLoginPage()) return handleLogin(phase);",
    "  if (!phase) return done(true, idleMessage(), { phase: '' }, false);",
    "  if (phase === 'claim') return handleClaim();",
    "  if (phase === 'spin') return handleSpin();",
    "  return done(true, idleMessage(), { phase: '' }, false);",
    "}"
  ]
}
