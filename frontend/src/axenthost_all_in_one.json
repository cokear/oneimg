{
  "name": "axenthost_all_in_one",
  "label": "AxentHost 自动助手（登录+领取+抽奖）",
  "url": "https://app.axenthost.com/claim",
  "enabled": true,
  "timeout": 480000,
  "timerMode": "window",
  "cooldownMinutes": "60-70",
  "windowSeconds": 180,
  "defaultData": {},
  "script": [
    "async function(ctx) {",
    "  const LOGIN_EMAIL = 'YOUR_EMAIL_HERE';",
    "  const LOGIN_PASSWORD = 'YOUR_PASSWORD_HERE';",
    "  const notifyId = (ctx.variables && ctx.variables.tg_notify_chat_id) || '5878981847';",
    "  const wait = (ms) => ctx.wait(ms);",
    "  const log = async (message) => {",
    "    if (ctx.log) await ctx.log(`[AxentHost] ${message}`);",
    "  };",
    "  const variables = (extra) => ({",
    "    ...(ctx.variables || {}),",
    "    ...(extra || {}),",
    "    tg_notify_chat_id: notifyId",
    "  });",
    "  const done = (success, message, extra, keepOpen) => ({",
    "    success,",
    "    message,",
    "    keepOpen: !!keepOpen,",
    "    variables: variables(extra || {})",
    "  });",
    "",
    "  const parseTimeTextToMs = (text) => {",
    "    const raw = String(text || '').trim();",
    "    if (!raw) return 0;",
    "    const parts = raw.split(':').map((part) => Number(part));",
    "    if (parts.some((part) => !Number.isFinite(part))) return 0;",
    "    if (parts.length === 3) return (parts[0] * 3600 + parts[1] * 60 + parts[2]) * 1000;",
    "    if (parts.length === 2) return (parts[0] * 60 + parts[1]) * 1000;",
    "    return 0;",
    "  };",
    "",
    "  const killPopups = () => {",
    "    document.querySelectorAll('[id*=\"interstitial\"], ins[id^=\"gpt_unit_\"]').forEach((ad) => ad.remove());",
    "    document.querySelectorAll('[aria-label=\"Close ad\"], [aria-label=\"Close\"], #dismiss-button, .close-button').forEach((button) => {",
    "      if (button.offsetWidth > 0 || button.offsetHeight > 0) button.click();",
    "    });",
    "    document.querySelectorAll('iframe[id^=\"aswift\"], iframe[name^=\"aswift\"]').forEach((iframe) => {",
    "      let parent = iframe.parentElement;",
    "      while (parent && parent.tagName !== 'BODY') {",
    "        const style = window.getComputedStyle(parent);",
    "        const zIndex = Number.parseInt(style.zIndex, 10);",
    "        if (zIndex > 10000 && (style.position === 'fixed' || style.position === 'absolute')) {",
    "          parent.remove();",
    "          break;",
    "        }",
    "        parent = parent.parentElement;",
    "      }",
    "    });",
    "  };",
    "",
    "  const readClaimsLeft = () => {",
    "    const counter = document.querySelector('.font-s1.mx-auto.mt-2');",
    "    const match = (counter && counter.innerText ? counter.innerText : '').match(/(\\d+)\\s*\\/\\s*5/);",
    "    return match ? Number(match[1]) : null;",
    "  };",
    "",
    "  const readCredits = () => {",
    "    const credit = document.querySelector('.credit-balance');",
    "    return credit ? (credit.textContent || '').replace(/\\D/g, '') : '';",
    "  };",
    "",
    "  const isLoginPage = () => {",
    "    if (window.location.pathname === '/login') return true;",
    "    return !!document.querySelector('input[type=\"email\"]') && !!document.querySelector('input[type=\"password\"]');",
    "  };",
    "",
    "  const gotoPhase = async (path, phase, extra) => {",
    "    ctx.variables.phase = phase;",
    "    Object.assign(ctx.variables, extra || {});",
    "    await log(`跳转到 ${path}，阶段 ${phase}`);",
    "    if (window.location.pathname === path) {",
    "      await ctx.reload();",
    "    } else {",
    "      await ctx.navigate(path);",
    "    }",
    "  };",
    "",
    "  const findSpinButton = () => {",
    "    const candidates = Array.from(document.querySelectorAll('div.spin, button.spin, .spin, button, [role=\"button\"]'));",
    "    return candidates.find((item) => {",
    "      const text = (item.innerText || item.textContent || '').trim().toUpperCase();",
    "      return text.includes('SPIN') && !item.classList.contains('disabled');",
    "    });",
    "  };",
    "",
    "  const getSpinCooldownText = () => {",
    "    for (const item of document.querySelectorAll('span.text-white.font-s4')) {",
    "      const text = (item.innerText || item.textContent || '').trim();",
    "      if (/^\\d{1,2}:\\d{2}(:\\d{2})?$/.test(text) && !item.closest('.spin')) return text;",
    "    }",
    "    return '';",
    "  };",
    "",
    "  const phase = (ctx.variables && ctx.variables.phase) || 'claim';",
    "  killPopups();",
    "  await wait(1800);",
    "  killPopups();",
    "",
    "  if (isLoginPage()) {",
    "    if (!LOGIN_EMAIL || !LOGIN_PASSWORD || LOGIN_EMAIL === 'YOUR_EMAIL_HERE' || LOGIN_PASSWORD === 'YOUR_PASSWORD_HERE') {",
    "      return done(false, '检测到登录页，但脚本里的 LOGIN_EMAIL/LOGIN_PASSWORD 还没有填写', { phase: 'login' }, true);",
    "    }",
    "",
    "    await log('检测到登录页，尝试自动登录');",
    "    const loginDeadline = Date.now() + 180000;",
    "    while (Date.now() < loginDeadline) {",
    "      killPopups();",
    "      const emailInput = document.querySelector('input[type=\"email\"]');",
    "      const passwordInput = document.querySelector('input[type=\"password\"]');",
    "      const cfToken = document.querySelector('[name=\"cf-turnstile-response\"]');",
    "      const loginBtn = document.querySelector('button.btn-gradient-primary:not(.disabled)');",
    "",
    "      if (emailInput && emailInput.value !== LOGIN_EMAIL) {",
    "        emailInput.value = LOGIN_EMAIL;",
    "        emailInput.dispatchEvent(new Event('input', { bubbles: true }));",
    "        emailInput.dispatchEvent(new Event('change', { bubbles: true }));",
    "      }",
    "      if (passwordInput && passwordInput.value !== LOGIN_PASSWORD) {",
    "        passwordInput.value = LOGIN_PASSWORD;",
    "        passwordInput.dispatchEvent(new Event('input', { bubbles: true }));",
    "        passwordInput.dispatchEvent(new Event('change', { bubbles: true }));",
    "      }",
    "",
    "      if (loginBtn && cfToken && (cfToken.value || '').length > 100) {",
    "        await log('CF Token 就绪，提交登录');",
    "        loginBtn.click();",
    "        ctx.variables.phase = phase === 'login' ? 'claim' : phase;",
    "        await wait(3000);",
    "        if (!isLoginPage()) {",
    "          await gotoPhase('/claim', 'claim');",
    "          return;",
    "        }",
    "      }",
    "",
    "      await wait(1000);",
    "    }",
    "",
    "    return done(false, '登录阶段超时，可能需要人工完成 CF 或检查账号密码', { phase: 'login' }, true);",
    "  }",
    "",
    "  if (phase === 'claim') {",
    "    if (window.location.pathname !== '/claim') {",
    "      await gotoPhase('/claim', 'claim');",
    "      return;",
    "    }",
    "",
    "    await log('开始领取阶段');",
    "    const deadline = Date.now() + 180000;",
    "    let clicked = false;",
    "    let waitingForCfSince = 0;",
    "",
    "    while (Date.now() < deadline) {",
    "      killPopups();",
    "      if (isLoginPage()) {",
    "        await gotoPhase('/login', 'login');",
    "        return;",
    "      }",
    "",
    "      const claimsLeft = readClaimsLeft();",
    "      const disabledTimer = document.querySelector('button.disabled span.font-s4');",
    "      if (disabledTimer) {",
    "        const cooldownMs = parseTimeTextToMs(disabledTimer.textContent || '');",
    "        await log(cooldownMs > 0 ? `领取冷却中，约 ${Math.ceil(cooldownMs / 60000)} 分钟` : '领取按钮不可用');",
    "        await gotoPhase('/spin', 'spin', {",
    "          ax_claim_cooldown_ms: cooldownMs,",
    "          ax_claims_left: claimsLeft === null ? 'unknown' : claimsLeft",
    "        });",
    "        return;",
    "      }",
    "",
    "      const bodyText = document.body && document.body.innerText ? document.body.innerText : '';",
    "      if (bodyText.includes('Credits successfully claimed')) {",
    "        await log('领取成功');",
    "        await gotoPhase('/spin', 'spin', {",
    "          ax_claims_left: claimsLeft === null ? 'unknown' : claimsLeft,",
    "          ax_total_credits: readCredits()",
    "        });",
    "        return;",
    "      }",
    "",
    "      const claimBtn = document.querySelector('button.btn-gradient-primary:not(.disabled)');",
    "      const cfToken = document.querySelector('[name=\"cf-turnstile-response\"]');",
    "      if (claimBtn && !clicked) {",
    "        if (cfToken && (cfToken.value || '').trim().length <= 100) {",
    "          waitingForCfSince = waitingForCfSince || Date.now();",
    "          if (Date.now() - waitingForCfSince > 120000) {",
    "            return done(false, '等待领取 CF 验证超时，请人工通过后重试', { ax_claims_left: claimsLeft }, true);",
    "          }",
    "          await log('等待领取 CF 验证 token');",
    "        } else {",
    "          claimBtn.click();",
    "          clicked = true;",
    "          await log('已点击领取按钮');",
    "        }",
    "      }",
    "",
    "      await wait(1000);",
    "    }",
    "",
    "    return done(false, '领取阶段超时，未检测到成功提示或冷却计时', { ax_claims_left: readClaimsLeft() }, true);",
    "  }",
    "",
    "  if (phase === 'spin') {",
    "    if (window.location.pathname !== '/spin') {",
    "      await gotoPhase('/spin', 'spin');",
    "      return;",
    "    }",
    "",
    "    await log('开始抽奖阶段');",
    "    const deadline = Date.now() + 120000;",
    "    let clicked = false;",
    "",
    "    while (Date.now() < deadline) {",
    "      killPopups();",
    "      if (isLoginPage()) {",
    "        await gotoPhase('/login', 'login');",
    "        return;",
    "      }",
    "",
    "      const timerText = getSpinCooldownText();",
    "      if (timerText) {",
    "        const cooldownMs = parseTimeTextToMs(timerText);",
    "        return done(true, cooldownMs > 0 ? `抽奖完成或冷却中，约 ${Math.ceil(cooldownMs / 60000)} 分钟` : '抽奖完成或冷却中', {",
    "          phase: '',",
    "          ax_spin_cooldown_ms: cooldownMs,",
    "          ax_claims_left: readClaimsLeft(),",
    "          ax_total_credits: readCredits()",
    "        }, false);",
    "      }",
    "",
    "      const spinBtn = findSpinButton();",
    "      if (spinBtn && !clicked) {",
    "        spinBtn.click();",
    "        clicked = true;",
    "        await log('已点击 Spin 按钮');",
    "      }",
    "",
    "      await wait(1000);",
    "    }",
    "",
    "    return done(false, '抽奖阶段超时，未检测到冷却计时', { phase: 'spin' }, true);",
    "  }",
    "",
    "  await gotoPhase('/claim', 'claim');",
    "}"
  ]
}
